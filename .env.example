# --- support form (browser; safe to expose — RLS makes the table write-only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- support form storage (server-side only; never expose with VITE_) ---
# Service-role key of the support project (the one VITE_SUPABASE_URL points
# at, which holds support_requests). This is NOT the Pix
# CMS key. SUPPORT_SUPABASE_URL defaults to VITE_SUPABASE_URL.
SUPPORT_SUPABASE_URL=
SUPPORT_SUPABASE_SERVICE_ROLE_KEY=

# --- /news pages (server-side only; read by api/ functions, never the browser) ---
# Pixie CMS project. The service-role key is required because pix_posts has
# no anon read policy. Set these in the Vercel project (mark the key Sensitive)
# and in .env.local for local development. Do NOT prefix them with VITE_.
PIX_SUPABASE_URL=https://coggfnbqqyiqfsxvtaym.supabase.co
PIX_SUPABASE_SERVICE_ROLE_KEY=

# Optional escape hatch. The finished cards normally come from
# pix_posts.web_pages (copied to the public Supabase bucket by the CMS at
# publish). The app backend also keeps copies on the private bucket
# shortly-bucket.s3.ap-south-1.amazonaws.com; if a public CDN host is ever put
# in front of that bucket, name it here and those copies become usable too.
# Leave empty.
PIX_MEDIA_CDN=

# optional: canonical origin used in links, sitemaps and JSON-LD
# SITE_ORIGIN=https://www.dailymattr.com

# --- /news-studio (browser; public values — RLS guards the data) ---
# The News Studio Supabase project. Kept separate from VITE_SUPABASE_URL
# above, which is the support project. The same values are baked into
# news-studio/src/lib as defaults, so these only override them.
VITE_NEWS_STUDIO_SUPABASE_URL=https://ygxdrphajvrbjcaxhvcn.supabase.co
VITE_NEWS_STUDIO_SUPABASE_ANON_KEY=
VITE_NEWS_STUDIO_SUBSCRIBE_URL=https://ygxdrphajvrbjcaxhvcn.functions.supabase.co/subscribers
# --- /news-studio server-rendered SEO (api/_lib/studio.js; same project) ---
NEWS_STUDIO_SUPABASE_URL=https://ygxdrphajvrbjcaxhvcn.supabase.co
NEWS_STUDIO_SUPABASE_ANON_KEY=
