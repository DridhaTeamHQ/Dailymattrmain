# --- support form (browser; safe to expose — RLS makes the table write-only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- /news pages (server-side only; read by api/ functions, never the browser) ---
# Pixie CMS project. The service-role key is required because pix_posts has
# no anon read policy. Set these in the Vercel project (mark the key Sensitive)
# and in .env.local for local development. Do NOT prefix them with VITE_.
PIX_SUPABASE_URL=https://coggfnbqqyiqfsxvtaym.supabase.co
PIX_SUPABASE_SERVICE_ROLE_KEY=

# Optional escape hatch. The finished cards normally come from
# pix_posts.web_pages (copied to the public Supabase bucket by the CMS at
# publish). The app backend also keeps copies on the private bucket
# shortly-bucket.s3.ap-south-1.amazonaws.com; if a public CDN host is ever put
# in front of that bucket, name it here and those copies become usable too.
# Leave empty.
PIX_MEDIA_CDN=

# optional: canonical origin used in links, sitemaps and JSON-LD
# SITE_ORIGIN=https://www.dailymattr.com
